// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  nama        String
  nim         String    @unique
  email       String    @unique
  password    String    // bcrypt hash
  role        Role      @default(MAHASISWA)
  prodi       String?
  angkatan    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  wallet      Wallet?
  certificate Certificate?
  auditLogs   AuditLog[]
}

model Wallet {
  id             String        @id @default(cuid())
  userId         String        @unique
  walletAddress  String        @unique
  status         WalletStatus  @default(PENDING)
  verifiedAt     DateTime?
  verifiedBy     String?
  createdAt      DateTime      @default(now())

  user           User          @relation(fields: [userId], references: [id])
}

model Certificate {
  id             String      @id @default(cuid())
  userId         String      @unique
  nftAddress     String?     @unique   // alamat NFT di Solana
  metadataUri    String?               // link IPFS (Pinata gateway)
  txSignature    String?               // transaction hash
  status         CertStatus  @default(NOT_ISSUED)
  issuedAt       DateTime?
  issuedBy       String?               // wallet admin
  claimedAt      DateTime?
  revokedAt      DateTime?
  revokedBy      String?               // admin yang merevoke
  revokeReason   String?               // alasan revoke
  createdAt      DateTime    @default(now())

  user           User        @relation(fields: [userId], references: [id])
}

model CertificateBackup {
  id             String    @id @default(cuid())
  certificateId  String
  userId         String
  backupData     String    // JSON string dari semua data sertifikat
  nftAddress     String?
  metadataUri    String?
  txSignature    String?
  reason         String?   // alasan backup (revoke, recovery, manual, etc)
  createdAt      DateTime  @default(now())
  createdBy      String    // admin yang membuat backup
  usedAt         DateTime? // waktu backup digunakan untuk recovery
  usedBy         String?   // admin yang menggunakan backup untuk recovery
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  detail    String?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

enum Role {
  ADMIN
  MAHASISWA
}

enum WalletStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CertStatus {
  NOT_ISSUED
  MINTED
  CLAIMED
  REVOKED
}
