{
  "rules": [
    {
      "pathPattern": "/ijazah/**",
      "apiPath": "/api/actions/claim?nim=**"
    },
    {
      "pathPattern": "/ijazah/*",
      "apiPath": "/api/actions/claim?nim=*"
    },
    {
      "pathPattern": "/api/actions/claim**",
      "apiPath": "/api/actions/claim**"
    }
  ]
}
