# .env.example

# ===== DATABASE =====
# Gunakan PostgreSQL (contoh: Neon Serverless Postgres)
DATABASE_URL="postgresql://user:password@host/db"

# ===== AUTH =====
# Neon Auth (Better Auth) variables
NEON_AUTH_BASE_URL="https://..."
NEON_AUTH_COOKIE_SECRET="generate-a-secure-secret-here"

# ===== SOLANA =====
NEXT_PUBLIC_SOLANA_NETWORK="devnet"
NEXT_PUBLIC_SOLANA_RPC="https://api.devnet.solana.com"
# Server-only RPC (Disarankan: Helius, QuickNode, Alchemy)
SOLANA_RPC_URL=""

# Private key wallet admin — 2 format yang didukung:
# Format 1 (Base58): "3wHg7..." (dari Phantom → Export Private Key)
# Format 2 (Array): "[123,45,67,...]" (dari Solana CLI)
ADMIN_WALLET_PRIVATE_KEY=""

# ===== PINATA (IPFS) =====
PINATA_JWT=""
NEXT_PUBLIC_PINATA_GATEWAY="https://gateway.pinata.cloud"

# ===== GEMINI AI =====
# API key dari Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""

# ===== APP =====
NEXT_PUBLIC_APP_URL="http://localhost:3000"
